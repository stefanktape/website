---
import BaseLayout from "@layouts/BaseLayout.astro"; import { company } from "@data/company"; import { technicalStudies } from "@data/technical-studies"; import { services } from "@data/services";
export function getStaticPaths() { return technicalStudies.map((study) => ({ params: { slug: study.slug }, props: { study } })); } const { study } = Astro.props; const relatedServices = services.filter((s) => study.relatedServiceSlugs.includes(s.slug));
---
<BaseLayout title={`${study.title} | ${company.name}`} description={study.summary}><section class="page-hero"><a class="breadcrumb" href="/technical-studies/">← Technical Studies</a><p class="eyebrow">Comparative engineering study</p><h1>{study.title}</h1><p>{study.summary}</p></section><article class="study-detail"><section><p class="eyebrow">01 · Problem</p><h2>Decision context</h2><p>{study.problem}</p></section><section><p class="eyebrow">02 · Requirements</p><h2>What the route must satisfy</h2><ul>{study.requirements.map((x) => <li>{x}</li>)}</ul></section><section><p class="eyebrow">03 · Criteria</p><h2>How options are compared</h2><ol>{study.criteria.map((x) => <li>{x}</li>)}</ol></section><section><p class="eyebrow">04 · Options</p><h2>Comparison</h2><div class="option-grid">{study.options.map((option) => <article><h3>{option.title}</h3><p>{option.assessment}</p></article>)}</div></section><section><p class="eyebrow">05 · Recommendation</p><h2>Selection logic</h2><p>{study.recommendation}</p></section><section><p class="eyebrow">06 · Uncertainties</p><h2>What remains unknown</h2><ul>{study.uncertainties.map((x) => <li>{x}</li>)}</ul></section><section><p class="eyebrow">07 · Validation</p><h2>How to resolve the uncertainty</h2><ul>{study.validation.map((x) => <li>{x}</li>)}</ul></section><section><p class="eyebrow">Relevant services</p>{relatedServices.map((s) => <a class="related-link accent" href={`/services/#${s.slug}`}><strong>{s.title}</strong></a>)}</section></article></BaseLayout>
