---
import BaseLayout from "@layouts/BaseLayout.astro"; import ContactForm from "@components/ContactForm.astro"; import { company } from "@data/company";
---
<BaseLayout title={`Contact | ${company.name}`} description="Discuss a materials or coating-engineering problem."><section class="page-hero"><p class="eyebrow">Start with the decision</p><h1>Discuss an engineering problem</h1><p>Share the application, current evidence, constraints, candidate routes, and the decision you need to make. A useful first conversation identifies whether a focused analysis can help.</p></section><section class="contact-section"><div><h2>Useful context to include</h2><ul><li>Service environment and component</li><li>Target coating function or failure concern</li><li>Materials, feedstocks, or processes under consideration</li><li>Evidence already available</li><li>Decision and timeline</li></ul><p>Email: <a href={`mailto:${company.email}`}>{company.email}</a></p></div><ContactForm /></section></BaseLayout>
