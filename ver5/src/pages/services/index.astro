---
import BaseLayout from "@layouts/BaseLayout.astro"; import { company } from "@data/company"; import { services } from "@data/services";
---
<BaseLayout title={`Consulting Services | ${company.name}`} description="Independent technical reviews, comparative studies, feedstock selection, materials and process selection, supplier intelligence, and development scoping."><section class="page-hero"><p class="eyebrow">Commercial layer</p><h1>Consulting services</h1><p>Focused engineering analysis for decisions from application requirements to feedstock, process, coating performance, and validation planning.</p></section><section class="section service-list">{services.map((service, i) => <article id={service.slug} class="service-detail"><div><p class="eyebrow">0{i + 1} · Consulting service</p><h2>{service.title}</h2><p class="lead">{service.summary}</p><p class="scope-note">Scope boundary: {service.boundary}</p></div><div><h3>Problems addressed</h3><ul>{service.problems.map((x) => <li>{x}</li>)}</ul><h3>Typical deliverables</h3><ul>{service.deliverables.map((x) => <li>{x}</li>)}</ul><a class="text-link" href={`/contact/?service=${service.slug}`}>Discuss this service →</a></div></article>)}</section></BaseLayout>
