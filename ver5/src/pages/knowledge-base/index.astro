---
import BaseLayout from "@layouts/BaseLayout.astro"; import KnowledgeCard from "@components/KnowledgeCard.astro"; import { company } from "@data/company"; import { knowledgeDomains, knowledgeEntries } from "@data/knowledge";
---
<BaseLayout title={`Knowledge Base | ${company.name}`} description="A connected materials and surface-engineering knowledge base."><section class="page-hero"><p class="eyebrow">Knowledge layer</p><h1>Knowledge Base</h1><p>Trace the engineering chain from application requirement through material, feedstock, process, microstructure, performance, degradation, and verification.</p></section>{knowledgeDomains.map((domain) => <section class="section knowledge-domain" id={domain.type}><div class="domain-heading"><p class="eyebrow">{domain.type.replace("-", " ")}</p><h2>{domain.title}</h2><p>{domain.text}</p></div><div class="knowledge-grid">{knowledgeEntries.filter((entry) => entry.type === domain.type).map((entry) => <KnowledgeCard entry={entry} />)}{knowledgeEntries.filter((entry) => entry.type === domain.type).length === 0 && <p class="empty-note">Entries are under technical review before publication.</p>}</div></section>)}</BaseLayout>
