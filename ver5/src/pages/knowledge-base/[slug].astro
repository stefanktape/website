---
import BaseLayout from "@layouts/BaseLayout.astro"; import { company } from "@data/company"; import { knowledgeEntries } from "@data/knowledge"; import { services } from "@data/services";
export function getStaticPaths() { return knowledgeEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props; const related = knowledgeEntries.filter((candidate) => candidate.slug !== entry.slug && Object.values(entry.links).flat().includes(candidate.slug)); const relatedServices = services.filter((s) => entry.links.services?.includes(s.slug));
---
<BaseLayout title={`${entry.title} | ${company.name}`} description={entry.summary}><section class="page-hero"><a class="breadcrumb" href="/insights/">← Insights</a><p class="eyebrow">{entry.eyebrow}</p><h1>{entry.title}</h1><p>{entry.summary}</p></section><section class="article-layout"><article><div class="question-callout"><span>Engineering question</span><h2>{entry.question}</h2></div><dl class="fact-list">{entry.details.map((detail) => <div><dt>{detail.label}</dt><dd>{detail.value}</dd></div>)}</dl><h2>Engineering notes</h2><ul>{entry.engineeringNotes.map((note) => <li>{note}</li>)}</ul><h2>Limitations</h2><ul>{entry.limitations.map((note) => <li>{note}</li>)}</ul><h2>Evidence basis</h2><ul>{entry.sources.map((source) => <li>{source}</li>)}</ul></article><aside><h2>Related entries</h2>{related.map((item) => <a class="related-link" href={`/knowledge-base/${item.slug}/`}><span>{item.eyebrow}</span><strong>{item.title}</strong></a>)}<h2>Relevant support</h2>{relatedServices.map((service) => <a class="related-link accent" href={`/#${service.slug}`}><span>Service</span><strong>{service.title}</strong></a>)}</aside></section><section class="article-cta"><h2>Need to apply this to a specific system?</h2><p>Start with the application, evidence already available, and the decision you need to make.</p><a class="button" href="/contact/">Discuss your engineering problem</a></section></BaseLayout>
