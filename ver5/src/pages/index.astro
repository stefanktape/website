---
import BaseLayout from "@layouts/BaseLayout.astro";
import KnowledgeCard from "@components/KnowledgeCard.astro";
import StudyCard from "@components/StudyCard.astro";
import { company } from "@data/company";
import { services } from "@data/services";
import { knowledgeEntries } from "@data/knowledge";
import { technicalStudies } from "@data/technical-studies";
const problems = ["Turn application requirements into coating-system criteria", "Compare ceramic feedstocks beyond nominal chemistry", "Connect spray parameters to particle behavior and microstructure", "Screen materials and suppliers on technical fit", "Define evidence, risks, and validation before development begins"];
const chain = ["Application", "Function", "Architecture", "Material", "Feedstock", "Process", "Particle behavior", "Microstructure", "Properties", "Performance", "Verification"];
---
<BaseLayout title={`${company.name} — ${company.positioning}`} description={company.description}>
  <section class="hero consultancy-hero"><div class="hero-copy"><p class="eyebrow">{company.positioning}</p><h1>Independent materials engineering from feedstock to coating performance.</h1><p class="hero-text">{company.specialization}</p><p>Structured technical analysis for ceramic feedstocks, thermal spray, TBC/EBC systems, and high-temperature coating decisions.</p><div class="hero-actions"><a class="button" href="/contact/">Discuss an engineering problem</a><a class="button button-secondary" href="/insights/">View insights</a></div></div><div class="hero-media"><img src="/industrial-spraying-hero.png" alt="Thermal spray coating process" width="780" height="520" /></div></section>
  <section class="section"><div class="section-heading"><p class="eyebrow">Problems I help solve</p><h2>Make the engineering decision explicit</h2><p>Independent analysis connects requirements, evidence, trade-offs, and validation—not just products and supplier claims.</p></div><div class="problem-grid">{problems.map((problem, i) => <article><span>0{i + 1}</span><p>{problem}</p></article>)}</div></section>
  <div class="section-dark"><section class="section"><p class="eyebrow">Engineering chain</p><h2>Follow cause and effect across the coating system</h2><div class="engineering-chain">{chain.map((item, i) => <span>{item}{i < chain.length - 1 && <b aria-hidden="true">→</b>}</span>)}</div></section></div>
  <section class="section service-list" id="services"><div class="section-heading"><p class="eyebrow">Consulting services</p><h2>Analysis matched to the decision in front of you</h2><p>Focused engineering analysis for decisions from application requirements to feedstock, process, coating performance, and validation planning.</p></div>{services.map((service, i) => <article id={service.slug} class="service-detail"><div><p class="eyebrow">0{i + 1} · Consulting service</p><h2>{service.title}</h2><p class="lead">{service.summary}</p><p class="scope-note">Scope boundary: {service.boundary}</p></div><div><h3>Problems addressed</h3><ul>{service.problems.map((x) => <li>{x}</li>)}</ul><h3>Typical deliverables</h3><ul>{service.deliverables.map((x) => <li>{x}</li>)}</ul><a class="text-link" href={`/contact/?service=${service.slug}`}>Discuss this service →</a></div></article>)}</section>
  <div class="section-muted"><section class="section"><div class="section-heading"><p class="eyebrow">Insights</p><h2>Engineering notes and transparent studies</h2></div><div class="knowledge-grid">{technicalStudies.map((study) => <StudyCard study={study} />)}{knowledgeEntries.slice(0, 2).map((entry) => <KnowledgeCard entry={entry} typeLabel="Field note" />)}</div><a class="button button-secondary section-cta" href="/insights/">View all insights</a></section></div>
  <section class="section about-section" id="about"><div class="about-photo"><img src="/founder-photo-placeholder.jpg" alt="" width="480" height="600" /><!-- TODO: add photo --></div><div><p class="eyebrow">About</p><h2>Independent analysis at the intersection of materials, process, and coating performance.</h2><p>{company.about}</p><p>The work focuses on ceramic feedstocks, thermal spray, TBC/EBC architectures, and high-temperature coatings. Requirements become criteria; criteria guide material and process choices; and recommendations state their evidence, uncertainty, and validation needs.</p><p>Being based in Shanghai provides technical access to China’s advanced-materials manufacturing ecosystem. That access supports independent supplier intelligence: engineering first, sourcing second.</p><dl class="cv-list"><div><dt>Degree</dt><dd>Master’s student, Materials Science and Engineering</dd></div><div><dt>Institution</dt><dd>Shanghai Jiao Tong University</dd></div><div><dt>Research focus</dt><dd>Ceramic feedstocks, thermal spray, TBC/EBC, and high-temperature coating systems</dd></div><div><dt>Planned direction</dt><dd>Doctoral research in advanced materials and surface engineering</dd></div><div><dt>Location &amp; access</dt><dd>{company.location}</dd></div></dl></div></section>
  <section class="china-callout"><p class="eyebrow">Start with the decision</p><h2>Need technical advice for a coating-system decision?</h2><p>Share the application, current evidence, constraints, candidate routes, and the decision you need to make.</p><a class="button" href="/contact/">Discuss an engineering problem</a></section>
</BaseLayout>
