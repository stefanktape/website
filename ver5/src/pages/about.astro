import BaseLayout from "@layouts/BaseLayout.astro"; import { company } from "@data/company";
---
<BaseLayout title={`About | ${company.name}`} description={company.about}><section class="page-hero"><p class="eyebrow">About</p><h1>Independent analysis at the intersection of materials, process, and coating performance.</h1><p>{company.about}</p></section><section class="article-layout about-layout"><article><h2>Current focus</h2><p>The work focuses on ceramic feedstocks, thermal spray, TBC/EBC architectures, and high-temperature coatings. The method is to make the engineering chain visible: requirements become criteria; criteria guide material and process choices; and recommendations state their evidence, uncertainty, and validation needs.</p><h2>Why Shanghai</h2><p>Being based in Shanghai provides technical access to China’s advanced-materials manufacturing ecosystem. That access supports independent supplier intelligence: engineering first, sourcing second.</p></article><aside><p class="eyebrow">Working principles</p><ul><li>Separate supplier claims from independent assessment.</li><li>State assumptions, limitations, and unknowns.</li><li>Connect recommendations to validation.</li><li>Do not claim laboratory or production capabilities that are not in place.</li></ul></aside></section></BaseLayout>
