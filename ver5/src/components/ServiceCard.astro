---
import type { ConsultingService } from "@data/services";
const { service } = Astro.props as { service: ConsultingService };
---
<article class="service-card">
  <p class="eyebrow">Consulting service</p><h3>{service.title}</h3><p>{service.summary}</p>
  <ul>{service.deliverables.map((item) => <li>{item}</li>)}</ul>
  <a class="text-link" href={`/services/#${service.slug}`}>Explore the service →</a>
</article>
