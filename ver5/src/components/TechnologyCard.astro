---
import type { Technology } from "@data/technologies";

interface Props {
  technology: Technology;
}

const { technology } = Astro.props;
---

<article class="technology-card">
  <div class="technology-card__header">
    <span class="tech-badge">{technology.abbreviation}</span>
    <span class="tech-category">{technology.category === "advanced" ? "Advanced process" : technology.category === "solid-state" ? "Solid state" : "Thermal spray"}</span>
  </div>
  <h3>{technology.name}</h3>
  <p class="technology-card__desc">{technology.description}</p>
  <dl class="tech-meta">
    <div>
      <dt>Coating density</dt>
      <dd>{technology.coatingDensity}</dd>
    </div>
    <div>
      <dt>Feedstock</dt>
      <dd>{technology.feedstockForm.join(", ")}</dd>
    </div>
  </dl>
  <p class="tech-note">{technology.processNote}</p>
  <a class="text-link" href={`/categories/${technology.categorySlug}/`}>View category →</a>
</article>
