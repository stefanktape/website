---
import type { KnowledgeEntry } from "@data/knowledge";
const { entry } = Astro.props as { entry: KnowledgeEntry };
---
<article class="knowledge-card">
  <p class="eyebrow">{entry.eyebrow}</p><h3>{entry.title}</h3><p>{entry.summary}</p>
  <a class="text-link" href={`/knowledge-base/${entry.slug}/`}>Read engineering notes →</a>
</article>
