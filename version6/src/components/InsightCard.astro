---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/config";
import { pagePath } from "../i18n/paths";
import { ui } from "../i18n/ui";
const { entry, locale } = Astro.props as { entry: CollectionEntry<"insights">; locale: Locale };
const t = ui[locale];
const typeLabel = entry.data.type.replaceAll("-", " ");
---
<article class="insight-card"><div class="meta"><span>{typeLabel}</span><time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString(locale === "zh" ? "zh-CN" : "en-GB", { year: "numeric", month: "short", day: "numeric" })}</time></div><h3><a href={pagePath(locale,"insights",entry.data.slug)}>{entry.data.title}</a></h3><p>{entry.data.summary}</p>{entry.data.tags.length > 0 && <ul class="tags" aria-label="Tags">{entry.data.tags.slice(0,4).map(tag => <li>{tag}</li>)}</ul>}<a class="text-link" href={pagePath(locale,"insights",entry.data.slug)}>{t.insights.read} →</a></article>
