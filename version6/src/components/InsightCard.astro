---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/config";
import { pagePath } from "../i18n/paths";
import { formatDate } from "../lib/insights";
import { ui } from "../i18n/ui";
import Arrow from "./Arrow.astro";
const { entry, locale } = Astro.props as { entry: CollectionEntry<"insights">; locale: Locale };
const t = ui[locale];
---
<article class="insight-card">
  <div class="meta"><span class="type-label">{t.types[entry.data.type]}</span><time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt, locale)}</time></div>
  <h3><a href={pagePath(locale, "insights", entry.data.slug)}>{entry.data.title}</a></h3>
  <p>{entry.data.summary}</p>
  {entry.data.tags.length > 0 && <ul class="tags" aria-label={t.insights.tags}>{entry.data.tags.slice(0, 4).map(tag => <li>{tag}</li>)}</ul>}
  <a class="text-link" href={pagePath(locale, "insights", entry.data.slug)} aria-label={`${t.insights.read}: ${entry.data.title}`}>{t.insights.read}<Arrow /></a>
</article>
