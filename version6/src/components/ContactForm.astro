---
import Arrow from "./Arrow.astro";
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";
import { site } from "@data/site";
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale].contact;
---
<form class="contact-form" action={`mailto:${site.email}`} method="post" enctype="text/plain" data-email-form aria-describedby="email-form-note">
  <label>{t.name} <span>{t.required}</span><input required type="text" name="name" autocomplete="name" maxlength="200" /></label>
  <label>{t.organization} <span>{t.optional}</span><input type="text" name="organization" autocomplete="organization" maxlength="200" /></label>
  <label>{t.email} <span>{t.required}</span><input required type="email" name="email" autocomplete="email" maxlength="254" /></label>
  <label>{t.topic} <span>{t.optional}</span><input type="text" name="topic" maxlength="200" /></label>
  <label class="full-width">{t.message} <span>{t.required}</span><textarea required name="message" rows="6" maxlength="4000"></textarea></label>
  <button class="button" type="submit">{t.send}<Arrow /></button>
</form>
<script>
  import { prepareEmail } from "../lib/email.mjs";
  document.querySelectorAll<HTMLFormElement>("[data-email-form]").forEach(form => {
    form.addEventListener("submit", event => {
      event.preventDefault();
      const data = new FormData(form);
      const fields = Object.fromEntries(["name", "organization", "email", "topic", "message"].map(key => [key, String(data.get(key) ?? "")]));
      window.location.href = prepareEmail(form.action, fields);
    });
  });
</script>
