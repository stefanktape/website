---
interface Props { direction?: "right" | "up-right" | "left"; }
const { direction = "right" } = Astro.props;
---
<svg class:list={["arrow", { "arrow-diagonal": direction === "up-right", "arrow-left": direction === "left" }]} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
