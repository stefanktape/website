---
import { site } from "@data/site";
interface Props { dark?: boolean; }
const { dark = false } = Astro.props;
const logo = dark ? site.logo.dark : site.logo.light;
---
{logo ? <img class="brand-image" src={logo} width={site.logo.width} height={site.logo.height} alt={site.name} decoding="async" /> :
  <span class="wordmark"><b>SV</b><span>SOLUTIONS</span></span>
}
