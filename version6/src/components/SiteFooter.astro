---
import type { Locale } from "../i18n/config";
import { pagePath } from "../i18n/paths";
import { ui } from "../i18n/ui";
import { site } from "@data/site";
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---
<footer class="site-footer"><div><strong>{site.name}</strong><span>{t.footer.line}</span></div><nav aria-label="Footer"><a href={pagePath(locale,"insights")}>{t.nav.insights}</a><a href={pagePath(locale,"about")}>{t.nav.about}</a><a href={pagePath(locale,"contact")}>{t.nav.contact}</a></nav></footer>
