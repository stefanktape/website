---
import BaseLayout from "@layouts/BaseLayout.astro";
import InsightCard from "@components/InsightCard.astro";
import EmptyInsights from "@components/EmptyInsights.astro";
import Arrow from "@components/Arrow.astro";
import { locales, type Locale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import { pagePath } from "../../i18n/paths";
import { site } from "@data/site";
import { home } from "@data/home";
import { getPublishedInsights } from "../../lib/insights";
import { featuredInsights } from "../../lib/publishing.mjs";

export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = ui[locale];
const content = home[locale];
const entries = featuredInsights(await getPublishedInsights(locale));
---
<BaseLayout locale={locale} page="home" title={t.meta.title} description={t.meta.description} alternates={{ en: "", zh: "" }}>
  <section class="hero-surface">
  <div class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="brand-dot" aria-hidden="true"></span>{content.hero.eyebrow}</p>
      <h1>{content.hero.title}</h1>
      <p class="hero-text">{content.hero.text}</p>
      <div class="hero-actions"><a class="button" href={pagePath(locale, "insights")}>{t.actions.explore}<Arrow /></a><a class="button button-secondary" href={pagePath(locale, "contact")}>{t.actions.contact}<Arrow direction="up-right" /></a></div>
      <p class="hero-note">{content.hero.note}</p>
    </div>
    <aside class="research-panel" aria-label={content.hero.panelLabel}>
      <div class="panel-top"><span>{content.hero.panelLabel}</span><span class="panel-cross" aria-hidden="true">+</span></div>
      <h2>{content.hero.panelTitle}</h2>
      <ul>{content.hero.topics.map(topic => <li><span>{topic}</span><Arrow direction="up-right" /></li>)}</ul>
      <p class="panel-bottom"><span aria-hidden="true"></span>{content.hero.panelNote}</p>
    </aside>
  </div>
  </section>

  <section class="section section-capabilities">
    <div class="container">
      <header class="section-heading heading-split">
        <div><p class="eyebrow"><span class="section-number">01 /</span>{content.capabilities.eyebrow}</p><h2>{content.capabilities.title}</h2></div>
        <p class="section-description">{content.capabilities.intro}</p>
      </header>
      <div class="capability-grid">{content.capabilities.items.map((item, index) =>
        <article class="capability-card"><span class="capability-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p><small>{item.detail}</small></article>
      )}</div>
    </div>
  </section>

  <section class="section container">
    <header class="section-heading heading-split">
      <div><p class="eyebrow"><span class="section-number">02 /</span>{content.featured.eyebrow}</p><h2>{content.featured.title}</h2></div>
      <a class="text-link" href={pagePath(locale, "insights")}>{t.actions.all}<Arrow /></a>
    </header>
    <p class="section-lead">{content.featured.intro}</p>
    {entries.length > 0 ? <div class="insight-grid">{entries.map(entry => <InsightCard entry={entry} locale={locale} />)}</div> : <EmptyInsights locale={locale} />}
  </section>

  <section class:list={["section", "container", "founder-section", { "has-portrait": Boolean(site.portrait) }]}>
    <div class="founder-heading"><p class="eyebrow"><span class="section-number">03 /</span>{content.founder.eyebrow}</p><h2>{content.founder.title}</h2>
      {site.portrait && <img class="founder-portrait" src={site.portrait} width="520" height="650" loading="lazy" alt={content.founder.portraitAlt} />}
    </div>
    <div class="founder-copy"><div class="founder-id"><span class="id-marker" aria-hidden="true"></span><div><h3>{content.founder.name}</h3><p>{content.founder.role}</p></div></div><p>{content.founder.text}</p><a class="text-link" href={pagePath(locale, "about")}>{t.actions.about}<Arrow direction="up-right" /></a></div>
  </section>

  <section class="contact-cta container">
    <div><p class="eyebrow">{content.cta.eyebrow}</p><h2>{content.cta.title}</h2></div>
    <div class="cta-action"><p>{content.cta.text}</p><a class="button" href={pagePath(locale, "contact")}>{t.actions.contact}<Arrow direction="up-right" /></a></div>
  </section>
</BaseLayout>
