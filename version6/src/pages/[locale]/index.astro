---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import InsightCard from "@components/InsightCard.astro";
import { locales, type Locale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import { assetPath, pagePath } from "../../i18n/paths";
import { site } from "@data/site";
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = ui[locale];
const insights = (await getCollection("insights", ({ data }) => data.locale === locale && !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = insights.filter(item => item.data.featured).slice(0,4);
const portrait = site.portrait;
---
<BaseLayout locale={locale} page="home" title={t.meta.title} description={t.meta.description} alternates={{ en:"", zh:"" }}>
  <section class="hero"><p class="eyebrow">{t.hero.eyebrow}</p><h1>{t.hero.title}</h1><p class="hero-text">{t.hero.text}</p><a class="button" href={pagePath(locale,"insights")}>{t.hero.cta}</a></section>
  <section class="section"><header class="section-heading"><p class="eyebrow">{t.competence.eyebrow}</p><h2>{t.competence.title}</h2></header><div class="competence-grid">{t.competence.items.map((item,index) => <article><span>0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
  {featured.length > 0 && <section class="section section-rule"><header class="section-heading"><p class="eyebrow">{t.featured.eyebrow}</p><h2>{t.featured.title}</h2></header><div class="insight-grid">{featured.map(entry => <InsightCard entry={entry} locale={locale}/>)}</div><a class="text-link section-link" href={pagePath(locale,"insights")}>{t.featured.all} →</a></section>}
  <section class:list={["section","about-preview",portrait && "has-portrait"]}>{portrait && <img src={assetPath(portrait)} width="520" height="650" alt={locale === "zh" ? "Stepan Kalashnikov（思凡）的肖像" : "Portrait of Stepan Kalashnikov"}/>}<div><p class="eyebrow">{t.homeAbout.eyebrow}</p><h2>{t.homeAbout.title}</h2><p>{t.homeAbout.text}</p><a class="text-link" href={pagePath(locale,"about")}>{t.homeAbout.link} →</a></div></section>
  <section class="contact-cta"><div><h2>{t.cta.title}</h2><p>{t.cta.text}</p></div><a class="button" href={pagePath(locale,"contact")}>{t.cta.link}</a></section>
</BaseLayout>
