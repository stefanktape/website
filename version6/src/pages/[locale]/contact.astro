---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import Arrow from "@components/Arrow.astro";
import { locales, type Locale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import { site } from "@data/site";
import { contact } from "@data/contact";
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = ui[locale];
const content = contact[locale];
---
<BaseLayout locale={locale} page="contact" title={t.contact.metaTitle} description={content.intro} alternates={{ en: "", zh: "" }}>
  <header class="page-intro container"><p class="eyebrow">{t.contact.eyebrow}</p><h1>{content.title}</h1><p>{content.intro}</p></header>
  <section class="contact-layout container">
    <div class="contact-details"><p class="eyebrow">{t.contact.direct}</p><a class="contact-email" href={`mailto:${site.email}`}>{site.email}<Arrow direction="up-right" /></a><p>{content.note}</p>{site.social.linkedin && <a class="text-link" href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<Arrow direction="up-right" /></a>}</div>
    <div class="form-panel"><h2>{content.formTitle}</h2><p id="email-form-note">{content.formNote}</p><ContactForm locale={locale} /></div>
  </section>
</BaseLayout>
