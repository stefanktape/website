---
import BaseLayout from "@layouts/BaseLayout.astro";
import Arrow from "@components/Arrow.astro";
import { locales, type Locale } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import { pagePath } from "../../i18n/paths";
import { site } from "@data/site";
import { profile } from "@data/profile";
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = ui[locale];
const data = profile[locale];
---
<BaseLayout locale={locale} page="about" title={t.about.metaTitle} description={data.intro} alternates={{ en: "", zh: "" }}>
  <header class="page-intro container"><p class="eyebrow">{t.about.eyebrow}</p><h1>{data.title}</h1><p>{data.intro}</p></header>
  <div class="profile-layout container">
    <aside class="profile-sidebar">
      {site.portrait && <img class="founder-portrait" src={site.portrait} width="520" height="650" alt={data.founderName} />}
      <h2>{data.founderName}</h2><p>{data.founderRole}</p>
      <dl><div><dt>{t.about.location}</dt><dd>{locale === "zh" ? "中国上海" : site.location}</dd></div><div><dt>{t.actions.email}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div></dl>
      {site.social.linkedin && <a class="text-link" href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<Arrow direction="up-right" /></a>}
    </aside>
    <div class="profile-content">
      <section><h2>{t.about.focus}</h2><ul class="focus-list">{data.focus.map(item => <li>{item}</li>)}</ul></section>
      <section><h2>{t.about.education}</h2>{data.education.map(item => <article class="timeline"><span class="period">{item.period}</span><div><h3>{item.place}</h3><p class="role">{item.role}</p><p>{item.detail}</p></div></article>)}</section>
      <section><h2>{t.about.experience}</h2>{data.experience.map(item => <article class="timeline"><span class="period">{item.period}</span><div><h3>{item.place}</h3><p class="role">{item.role}</p>{item.detail && <p>{item.detail}</p>}</div></article>)}</section>
      <section><h2>{t.about.publication}</h2><p>{data.publication}</p><a class="text-link doi" href="https://doi.org/10.1016/j.mencom.2024.02.038" target="_blank" rel="noopener noreferrer">DOI: 10.1016/j.mencom.2024.02.038<Arrow direction="up-right" /></a></section>
      <section class="profile-split"><div><h2>{t.about.tools}</h2><ul class="tags tool-list">{data.tools.map(item => <li>{item}</li>)}</ul></div><div><h2>{t.about.languages}</h2><ul class="plain-list">{data.languages.map(item => <li>{item}</li>)}</ul></div></section>
      <section><h2>{t.about.future}</h2><p>{data.future}</p><a class="text-link" href={pagePath(locale, "contact")}>{t.about.contact}<Arrow /></a></section>
    </div>
  </div>
</BaseLayout>
