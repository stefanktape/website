---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Arrow from "@components/Arrow.astro";
import { pagePath } from "../../../i18n/paths";
import { getPublishedInsights, getArticleAlternates, formatDate } from "../../../lib/insights";
import type { Locale } from "../../../i18n/config";
import { ui } from "../../../i18n/ui";
import { site } from "@data/site";
export async function getStaticPaths() {
  const entries = await getPublishedInsights();
  return entries.map(entry => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry, alternates: getArticleAlternates(entry, entries) }
  }));
}
const { entry, alternates } = Astro.props as { entry: CollectionEntry<"insights">; alternates: Partial<Record<Locale, string>> };
const locale = entry.data.locale;
const t = ui[locale];
const { Content } = await render(entry);
const visual = entry.data.featuredVisual;
const otherLocale = locale === "en" ? "zh" : "en";
---
<BaseLayout locale={locale} page="insights" slug={entry.data.slug} title={`${entry.data.title} | ${site.name}`} description={entry.data.summary} alternates={alternates} article publishedAt={entry.data.publishedAt} updatedAt={entry.data.updatedAt} image={visual?.kind === "image" ? visual.src : undefined}>
  <article class="article container">
    <a class="back-link" href={pagePath(locale, "insights")}><Arrow direction="left" />{t.insights.back}</a>
    <header class="article-header">
      <div class="meta"><span class="type-label">{t.types[entry.data.type]}</span><time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt, locale)}</time></div>
      <h1>{entry.data.title}</h1><p class="article-summary">{entry.data.summary}</p>
      {entry.data.updatedAt && <p class="updated-date">{t.insights.updated} <time datetime={entry.data.updatedAt.toISOString()}>{formatDate(entry.data.updatedAt, locale)}</time></p>}
      {entry.data.tags.length > 0 && <ul class="tags" aria-label={t.insights.tags}>{entry.data.tags.map(tag => <li>{tag}</li>)}</ul>}
      {!alternates[otherLocale] && <p class="translation-note">{t.insights.unavailable}</p>}
    </header>
    {visual?.kind === "image" && <figure class="featured-visual"><img src={visual.src} alt={visual.alt} />{(visual.caption || visual.credit) && <figcaption>{visual.caption}{visual.caption && visual.credit && " · "}{visual.credit}</figcaption>}</figure>}
    {visual?.kind === "summary-card" && <figure class="summary-card" aria-label={visual.alt}><p class="eyebrow">{t.insights.visual}</p><h2>{entry.data.title}</h2><p>{entry.data.summary}</p><ul class="tags">{entry.data.tags.slice(0, 5).map(tag => <li>{tag}</li>)}</ul>{(visual.caption || visual.credit) && <figcaption>{visual.caption}{visual.caption && visual.credit && " · "}{visual.credit}</figcaption>}</figure>}
    <div class="prose"><Content /></div>
    <footer class="article-bottom"><a class="text-link" href={pagePath(locale, "insights")}><Arrow direction="left" />{t.insights.back}</a></footer>
  </article>
</BaseLayout>
